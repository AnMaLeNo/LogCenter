# --- Backend ---
OPENSEARCH_HOST=opensearch-node
OPENSEARCH_PORT=9200
SEARCH_RESULTS_LIMIT=20

# CORS: with the production build the frontend and API are served from the same
# origin (nginx proxies /api -> backend), so CORS is not needed. Kept here for
# the dev workflow where the Vite dev server runs on a different port.
CORS_ORIGINS=http://localhost:5173

# --- Deployment (only used by docker-compose.override.yml for Traefik) ---
# Base domain for the reverse-proxy router rule (logcenter.${BASE_DOMAIN}).
# Harmless to leave set even without Traefik; the base compose ignores it.
BASE_DOMAIN=antoine42.com

# --- Ports (host side) ---
# Frontend container serves on :80 internally; mapped to this host port.
FRONTEND_PORT=5173
BACKEND_PORT=8420

# --- Frontend ---
# Leave empty/unset to use the default relative "/api" path (recommended:
# keeps the build deployment-agnostic). Only set this to point the frontend at
# a backend on a different origin (e.g. some dev setups).
# VITE_API_BASE_URL=
